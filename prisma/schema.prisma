generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                 String          @id @default(uuid())
  employeeCode       String          @unique
  name               String
  phone              String          @unique
  role               String          // e.g. "Site Surveyor", "Solar Electrician", etc.
  department         String          @default("Field Operations")
  pin                String          @default("1234")
  status             String          @default("Active") // Active, Busy, On Leave
  rating             Float           @default(5.0)
  totalCompletedJobs Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  assignedStages     ProjectStage[]
  updates            StageUpdate[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  reviews            Review[]
}

model Customer {
  id             String    @id @default(uuid())
  name           String
  phone          String
  email          String?
  address        String
  city           String
  state          String    @default("Delhi NCR")
  sanctionedLoad String?   // e.g. "5 kW 1-Phase"
  discomName     String?   // e.g. "BSES / Tata Power / DHBVN"
  consumerNumber String?
  createdAt      DateTime  @default(now())

  projects       Project[]
}

model Project {
  id                 String         @id @default(uuid())
  projectCode        String         @unique // e.g. "SP-2026-101"
  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  systemCapacityKW   Float          // e.g. 5.0 kW
  panelType          String         @default("550W Mono PERC Bifacial")
  inverterType       String         @default("5kW On-Grid Inverter")
  structureType      String         @default("Elevated GI Standard Roof")
  overallStatus      String         @default("In Progress") // In Progress, Completed, On Hold
  currentStageNumber Int            @default(1)
  contractValue      Float?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  stages             ProjectStage[]
  auditLogs          AuditLog[]
  reviews            Review[]
}

model ProjectStage {
  id                 String        @id @default(uuid())
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageNumber        Int           // 1 to 8
  title              String
  description        String
  requiredRole       String
  status             String        @default("Pending") // Pending, Assigned, In Progress, Completed
  assignedEmployeeId String?
  assignedEmployee   Employee?     @relation(fields: [assignedEmployeeId], references: [id])
  assignedAt         DateTime?
  completedAt        DateTime?
  checklistJson      String?       // serialized json array of checklist items

  updates            StageUpdate[]

  @@unique([projectId, stageNumber])
}

model StageUpdate {
  id          String       @id @default(uuid())
  stageId     String
  stage       ProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id])
  remarks     String
  photoUrl    String?
  metricsJson String?      // Serialized custom technical parameters (e.g. Earthing Ohm, Inverter Serial, Solar generation)
  createdAt   DateTime     @default(now())
}

model Notification {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  message    String
  projectId  String?
  stageId    String?
  isRead     Boolean   @default(false)
  actionUrl  String?
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id          String    @id @default(uuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  action      String    // STAGE_ASSIGNED, STAGE_UPDATED, STAGE_COMPLETED, PROJECT_CREATED, EMPLOYEE_ADDED, REVIEW_SUBMITTED
  performedBy String    // "Admin" or Employee Name
  details     String
  photoUrl    String?
  timestamp   DateTime  @default(now())
}

model Review {
  id            String    @id @default(uuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  rating        Int       // 1 to 5
  tagsJson      String    // Serialized tags e.g. '["Clean Wiring"]'
  comment       String
  customerName  String
  customerPhone String
  createdAt     DateTime  @default(now())
}
