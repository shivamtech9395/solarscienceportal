# ===================================================================
# ☀️ SOLARSCIENCE PORTAL - ENVIRONMENT VARIABLES
# ===================================================================

# 1. PostgreSQL Database URL (Supabase, Neon, Render, or Local)
#
# Examples:
# - Neon.tech (Recommended Free Cloud Postgres):
#   DATABASE_URL="postgresql://neondb_owner:npg_xyz@ep-sparkling-pool-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
#
# - Supabase Free Postgres:
#   DATABASE_URL="postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"
#
# - Local PostgreSQL:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solarscience?schema=public"

DATABASE_URL="postgresql://postgres:password@localhost:5432/solarscience?schema=public"

# 2. Application Environment
NODE_ENV="development"
PORT=3000
